# ============================================================================
# BOKO WEB (Vite) — CẤU HÌNH MÔI TRƯỜNG (MẪU)
#
#   cp .env.example .env    rồi điền giá trị thật vào .env
#
# .env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit file này.
# Trên Vercel thì set từng biến trong Settings → Environment Variables.
# ============================================================================

# --- Backend ---
# Để trống khi web chạy cùng domain với backend (nginx proxy, docker local:
# https://localhost/api/...). Trên Vercel phải trỏ tới backend Render.
# Ví dụ: VITE_BACKEND_URL=https://boko-backend.onrender.com
VITE_BACKEND_URL=

# --- Đăng nhập Google (Google Identity Services) ---
# Client ID OAuth loại "Web application" tạo tại https://console.cloud.google.com/apis/credentials
# Phải thêm Authorized JavaScript origins: https://boko-three.vercel.app (và http://localhost:3000 khi dev).
# Để trống => nút Google báo "chưa được cấu hình" (không tạo phiên giả).
VITE_GOOGLE_CLIENT_ID=

# --- Sentry (theo dõi lỗi frontend) ---
# Để trống => tắt hoàn toàn (no-op). Lấy DSN tại https://sentry.io (Project →
# SDK Setup → Keys).
VITE_SENTRY_DSN=
# production | development | <tên môi trường tuỳ ý>
VITE_SENTRY_ENVIRONMENT=production
# Version/tag release, ví dụ commit SHA hoặc số phiên bản.
VITE_SENTRY_RELEASE=
# 0.1 = lấy mẫu 10% phiên để đo hiệu năng; 0 = chỉ bắt lỗi.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
