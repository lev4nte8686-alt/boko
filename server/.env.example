# ============================================================================
# BOKO API — CẤU HÌNH MÔI TRƯỜNG (MẪU)
#
#   cp .env.example .env    rồi điền giá trị thật vào .env
#
# .env đã bị .gitignore chặn — KHÔNG BAO GIỜ commit file này.
# Trên Render/Vercel thì set từng biến trong mục Environment Variables.
# ============================================================================

# --- Database (Neon / Render) ---
# Ưu tiên 1: nguyên connection string (Neon cấp sẵn).
# Ví dụ: postgresql://neondb_owner:xxx@ep-xxx-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL=
DATABASE_API_URL=
NEON_DATABASE_API_URL=

# Cách 2 (fallback): ráp từng biến — chỉ dùng khi KHÔNG set DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=boko_db
# Neon/managed DB bắt buộc require; local docker dùng disable
DB_SSLMODE=disable
# Neon yêu cầu channel_binding=require khi connection string có nó
DB_CHANNEL_BINDING=
# Neon pooler (pgbouncer) không hỗ trợ prepared statement → bật true
DB_SIMPLE=true

# --- Mã hóa dữ liệu nhạy cảm (BẮT BUỘC) ---
# AES-256-GCM key cho users.name/phone, orders.phone/shipping_address.
# Tạo key:  openssl rand -base64 32
# ⚠ Thiếu biến này = EncryptString trả lỗi, khách không đăng ký được.
# ⚠ Đổi key = toàn bộ dữ liệu đã mã hóa cũ không giải mã được nữa.
APP_AES_KEY=
# Alias cũ, chỉ dùng 1 trong 2
AES_KEY=

# --- JWT (BẮT BUỘC: backend từ chối chạy nếu thiếu hoặc sai) ---
# Chuỗi hex tối thiểu 64 ký tự (32 byte) sinh ngẫu nhiên. Tạo bằng 1 trong:
#   PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
#   Linux/macOS: openssl rand -hex 32
JWT_SECRET=

# --- Server ---
# Cổng lắng nghe. Local mặc định 8080; nền tảng cloud (Render...) tự cấp qua PORT.
PORT=8080

# CORS cho web deploy cloud (Vercel...): liệt kê origin, phân tách dấu phẩy.
# Ví dụ: CORS_ORIGINS=https://boko-web.vercel.app,https://boko.com
CORS_ORIGINS=

# --- PayPal ---
# Client ID là public (nằm trong bundle frontend). Secret chỉ để trên server.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# --- MoMo (để trống = dùng key test sandbox công khai có sẵn trong code) ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_QUERY_URL=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# --- VNPay (để trống = dùng key test sandbox công khai có sẵn trong code) ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay-callback
VNPAY_IPN_URL=http://localhost:8080/api/payment/vnpay/ipn

# ============================================================================
# GHN (Giao Hàng Nhanh) — SHIPPING
#
#   Đơn hàng chỉ chuyển sang GHN quản lý SAU KHI ĐÃ ĐÓNG GÓI (status shipping).
#   Người mua vẫn bấm "Tôi đã nhận được hàng" để chốt đơn hoàn tất.
#
#   Lấy credential môi trường TEST tại https://ghn.dev/console → Cấu hình API
#   (Token + Shop ID). Môi trường test dùng dev-online-gateway.ghn.dev.
# ============================================================================
GHN_TOKEN=
GHN_SHOP_ID=
# Test/Dev: https://dev-online-gateway.ghn.vn  |  Production: https://online-gateway.ghn.vn
GHN_BASE_URL=https://dev-online-gateway.ghn.vn

# --- Điểm lấy hàng (kho Boko) ---
GHN_FROM_NAME=Boko Bookstore
GHN_FROM_PHONE=
GHN_FROM_ADDRESS=Số 1 Đường Sách, Phường Bến Nghé
GHN_FROM_WARD_NAME=Phường Bến Nghé
GHN_FROM_DISTRICT_NAME=Quận 1
GHN_FROM_PROVINCE_NAME=TP. Hồ Chí Minh

# --- Dịch vụ & phí ---
# service_type_id: 2 = giao thương mại điện tử (dưới 20kg), 5 = truyền thống/nhiều kiện
GHN_SERVICE_TYPE_ID=2
# payment_type_id: 1 = shop trả cước, 2 = người nhận trả
GHN_PAYMENT_TYPE_ID=1
# CHOTHUHANG | CHOXEMHANG | KHONGCHOXEMHANG | KHONGCHOTHUDHANG
GHN_REQUIRED_NOTE=KHONGCHOXEMHANG

# --- Bưu kiện ---
GHN_ITEM_WEIGHT=350
GHN_PACKAGE_WEIGHT=150
GHN_PARCEL_LENGTH=20
GHN_PARCEL_WIDTH=15
GHN_PARCEL_HEIGHT=6

# --- Đích đến mặc định cho môi trường TEST ---
# Dùng khi không tra được quận/huyện & phường/xã từ địa chỉ tự do.
# Lấy mã tại https://ghn.dev/console → Tra cứu địa chỉ hành chính.
GHN_TO_DISTRICT_ID=
GHN_TO_WARD_CODE=
GHN_TO_DISTRICT_NAME=Quận 1
GHN_TO_WARD_NAME=Phường Bến Nghé
GHN_TO_PROVINCE_NAME=TP. Hồ Chí Minh

# Bảo vệ webhook: nếu set, GHN cần gửi header X-GHN-Webhook-Secret hoặc ?secret=
GHN_WEBHOOK_SECRET=

# --- Tài khoản seed (KHÔNG hardcode mật khẩu trong code nữa) ---
# Backend tạo admin@boko.com / test@gmail.com từ 2 mật khẩu này (bcrypt).
# Để trống = bỏ qua, tài khoản đó không được tạo.
SEED_ADMIN_EMAIL=admin@boko.com
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_EMAIL=test@gmail.com
SEED_CUSTOMER_PASSWORD=
# =true: đồng bộ lại mật khẩu seed từ env cho tài khoản đã tồn tại
# (dùng sau khi chạy migrations/0002_seed_data.sql để đặt mật khẩu thật).
# Mặc định tắt để không vô tình reset mật khẩu khi restart.
SEED_UPDATE_PASSWORD=false